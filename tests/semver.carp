(load "Test.carp")

(load "semver.carp")

(use-all Semver Test)

(deftest test
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be tested for equality"
             =)
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Nothing))
             "semantic versions can be tested for equality"
             /=)
  (assert-equal test
    &(Maybe.Just (Semver.init 1 2 3 (Maybe.Nothing)))
    &(from-string "1.2.3")
    "simple semantic version parses correctly")
  (assert-equal test
    &(Maybe.Just (Semver.init 1 2 3 (Maybe.Just @"-tag")))
    &(from-string "1.2.3-tag")
    "semantic version with tag parses correctly")
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 4 (Maybe.Just @"-tag"))
             "semantic versions can be compared with < I"
             <)
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 3 0 (Maybe.Just @"-tag"))
             "semantic versions can be compared with < II"
             <)
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 2 0 0 (Maybe.Just @"-tag"))
             "semantic versions can be compared with < III"
             <)
  (assert-op test
             &(Semver.init 1 3 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 5 (Maybe.Just @"-tag"))
             "< is false when minor is greater but patch is smaller"
             >=)
  (assert-op test
             &(Semver.init 2 0 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 5 0 (Maybe.Just @"-tag"))
             "< is false when major is greater but minor is smaller"
             >=)
  (assert-op test
             &(Semver.init 1 2 4 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be compared with > I"
             >)
  (assert-op test
             &(Semver.init 1 3 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be compared with > II"
             >)
  (assert-op test
             &(Semver.init 2 0 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be compared with > III"
             >)
  (assert-equal test
    "1.2.3"
    &(str &(Semver.init 1 2 3 (Maybe.Nothing)))
    "str works for a simple version")
  (assert-equal test
    "1.2.3-tag"
    &(str &(Semver.init 1 2 3 (Maybe.Just @"-tag")))
    "str works for a version with a tag")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "")
    "from-string returns Nothing for an empty string")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "1")
    "from-string returns Nothing for a single number")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "1.2")
    "from-string returns Nothing for only major.minor")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "a.b.c")
    "from-string returns Nothing for non-numeric input")
  (assert-equal test
    &(Semver.init 0 0 0 (Maybe.Nothing))
    &(zero)
    "semantic versions can be created by zero"))
