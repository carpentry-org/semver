(load "Test.carp")

(load "semver.carp")

(use-all Semver Test)

(defn rel [maj min pat] (Semver.init maj min pat (Maybe.Nothing)))

(defn pre [maj min pat tag] (Semver.init maj min pat (Maybe.Just @tag)))

(deftest test
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be tested for equality"
             =)
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Nothing))
             "semantic versions can be tested for equality"
             /=)
  (assert-equal test
    &(Maybe.Just (Semver.init 1 2 3 (Maybe.Nothing)))
    &(from-string "1.2.3")
    "simple semantic version parses correctly")
  (assert-equal test
    &(Maybe.Just (Semver.init 1 2 3 (Maybe.Just @"-tag")))
    &(from-string "1.2.3-tag")
    "semantic version with tag parses correctly")
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 4 (Maybe.Just @"-tag"))
             "semantic versions can be compared with < I"
             <)
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 1 3 0 (Maybe.Just @"-tag"))
             "semantic versions can be compared with < II"
             <)
  (assert-op test
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             &(Semver.init 2 0 0 (Maybe.Just @"-tag"))
             "semantic versions can be compared with < III"
             <)
  (assert-op test
             &(Semver.init 1 3 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 5 (Maybe.Just @"-tag"))
             "< is false when minor is greater but patch is smaller"
             >=)
  (assert-op test
             &(Semver.init 2 0 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 5 0 (Maybe.Just @"-tag"))
             "< is false when major is greater but minor is smaller"
             >=)
  (assert-op test
             &(Semver.init 1 2 4 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be compared with > I"
             >)
  (assert-op test
             &(Semver.init 1 3 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be compared with > II"
             >)
  (assert-op test
             &(Semver.init 2 0 0 (Maybe.Just @"-tag"))
             &(Semver.init 1 2 3 (Maybe.Just @"-tag"))
             "semantic versions can be compared with > III"
             >)
  (assert-equal test
    "1.2.3"
    &(str &(Semver.init 1 2 3 (Maybe.Nothing)))
    "str works for a simple version")
  (assert-equal test
    "1.2.3-tag"
    &(str &(Semver.init 1 2 3 (Maybe.Just @"-tag")))
    "str works for a version with a tag")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "")
    "from-string returns Nothing for an empty string")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "1")
    "from-string returns Nothing for a single number")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "1.2")
    "from-string returns Nothing for only major.minor")
  (assert-equal test
    &(Maybe.Nothing)
    &(Semver.from-string "a.b.c")
    "from-string returns Nothing for non-numeric input")
  (assert-equal test
    &(Semver.init 0 0 0 (Maybe.Nothing))
    &(zero)
    "semantic versions can be created by zero")

  ; pre-release precedence (SemVer 2.0.0 §11)
  (assert-op test
             &(pre 1 0 0 "-alpha")
             &(rel 1 0 0)
             "a pre-release has lower precedence than the release"
             <)
  (assert-op test
             &(rel 1 0 0)
             &(pre 1 0 0 "-rc.1")
             "the release has higher precedence than a pre-release"
             >)
  (assert-false test
    (< &(pre 1 0 0 "-alpha") &(pre 1 0 0 "-alpha"))
    "equal pre-releases are not strictly ordered")
  (assert-op test
             &(pre 1 0 0 "-1")
             &(pre 1 0 0 "-alpha")
             "numeric identifiers rank below alphanumeric ones"
             <)
  (assert-op test
             &(pre 1 0 0 "-alpha.2")
             &(pre 1 0 0 "-alpha.11")
             "numeric identifiers compare numerically, not lexically"
             <)
  (assert-op test
             &(pre 1 0 0 "-alpha")
             &(pre 1 0 0 "-alpha.1")
             "a larger set of pre-release fields takes precedence"
             <)
  ; the canonical ordering from the SemVer 2.0.0 spec
  (assert-op test &(pre 1 0 0 "-alpha") &(pre 1 0 0 "-alpha.1") "spec chain 1" <)
  (assert-op test
             &(pre 1 0 0 "-alpha.1")
             &(pre 1 0 0 "-alpha.beta")
             "spec chain 2"
             <)
  (assert-op test
             &(pre 1 0 0 "-alpha.beta")
             &(pre 1 0 0 "-beta")
             "spec chain 3"
             <)
  (assert-op test &(pre 1 0 0 "-beta") &(pre 1 0 0 "-beta.2") "spec chain 4" <)
  (assert-op test
             &(pre 1 0 0 "-beta.2")
             &(pre 1 0 0 "-beta.11")
             "spec chain 5"
             <)
  (assert-op test &(pre 1 0 0 "-beta.11") &(pre 1 0 0 "-rc.1") "spec chain 6" <)
  (assert-op test &(pre 1 0 0 "-rc.1") &(rel 1 0 0) "spec chain 7" <)
  ; build metadata is ignored for precedence (SemVer 2.0.0 §10)
  (assert-false test
    (< &(pre 1 0 0 "-alpha+001") &(pre 1 0 0 "-alpha+999"))
    "build metadata does not affect precedence (forward)")
  (assert-false test
    (> &(pre 1 0 0 "-alpha+001") &(pre 1 0 0 "-alpha+999"))
    "build metadata does not affect precedence (backward)")
  (assert-false test
    (< &(Semver.init 1 0 0 (Maybe.Just @"+build")) &(rel 1 0 0))
    "build-only metadata has the same precedence as the bare release"))
